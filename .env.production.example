# Copy this file to /opt/amazon-ops/shared/.env on the server. Never upload it.
# Values must not contain whitespace. Generate POSTGRES_PASSWORD with:
# openssl rand -base64 36 | tr -dc 'A-Za-z0-9' | head -c 32
APP_DOMAIN=ops.example.com
APP_BASE_URL=https://ops.example.com
FRONTEND_BIND_PORT=3001

POSTGRES_DB=amazon_ops
POSTGRES_USER=amazon_ops
POSTGRES_PASSWORD=REPLACE_WITH_A_32_CHARACTER_RANDOM_PASSWORD

DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_KEY
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

LINGXING_MCP_URL=https://openmcp.lingxing.com/mcp-servers/lingxing-mcp
LINGXING_MCP_SECRET=REPLACE_WITH_LINGXING_SECRET
# Optional MCP integrations.
SELLER_SPRITE_MCP_SECRET=
SIF_MCP_SECRET=

IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_DB_POOL_SIZE=10
AD_DIAGNOSTIC_HISTORY_DB_POOL_SIZE=10
AUTH_DB_POOL_SIZE=10

# Optional LangSmith observability.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=amazon-ops-production
LANGSMITH_WORKSPACE_ID=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# SMTP is optional: user invitations and reset-by-email are currently disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# S3-compatible PostgreSQL backups. These are used only by the host backup job.
S3_ENDPOINT_URL=https://s3.example.com
S3_BUCKET=replace-with-private-backup-bucket
S3_REGION=us-east-1
S3_PREFIX=amazon-ops/postgres
AWS_ACCESS_KEY_ID=REPLACE_WITH_BACKUP_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_BACKUP_SECRET
BACKUP_RETENTION_DAYS=14
BACKUP_LOCAL_DIR=/opt/amazon-ops/backups
