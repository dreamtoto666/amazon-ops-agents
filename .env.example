# Copy this file to .env and fill in the real values locally.
# Never commit real MCP secrets.
SELLER_SPRITE_MCP_SECRET=
SIF_MCP_SECRET=
LINGXING_MCP_URL=https://openmcp.lingxing.com/mcp-servers/lingxing-mcp
LINGXING_MCP_SECRET=

# Shared LLM provider for controller and all specialist agents.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional LangSmith observability. When disabled or unset, no traces are sent.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=amazon-ops-local
# LANGSMITH_WORKSPACE_ID=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# PostgreSQL used by persistent task-creation idempotency.
POSTGRES_DB=amazon_ops
POSTGRES_USER=amazon_ops
POSTGRES_PASSWORD=amazon_ops
POSTGRES_PORT=5432
DATABASE_URL=postgresql://amazon_ops:amazon_ops@127.0.0.1:5432/amazon_ops

# Task creation idempotency.
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_DB_POOL_SIZE=10

# Authentication and transactional email. Keep SMTP credentials local only.
APP_BASE_URL=http://localhost:3001
AUTH_DB_POOL_SIZE=10
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
