# Copy this file to .env and fill in the real values locally.
# Never commit real MCP secrets.
SELLER_SPRITE_MCP_SECRET=
SIF_MCP_SECRET=
LINGXING_MCP_URL=https://openmcp.lingxing.com/mcp-servers/lingxing-mcp
LINGXING_MCP_SECRET=
# Core advertising reports use LingXing Open API. Obtain a new AppID/AppSecret
# from the LingXing Open Platform and keep them only in your local .env.
LINGXING_OPEN_API_BASE_URL=https://openapi.lingxing.com
LINGXING_OPEN_API_APP_ID=
LINGXING_OPEN_API_APP_SECRET=

# Shared LLM provider for controller and all specialist agents.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Chat input can choose either supported DeepSeek model per task.
# The default above is used when a caller does not make a choice.
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional reasoning effort. Leave empty to follow thinking_enabled; set to
# low/high/max to enable thinking at a chosen level, or off to disable it.
# Supported models: deepseek-v4-flash, deepseek-v4-pro, deepseek-v4-flash-vision-exp.
DEEPSEEK_REASONING_EFFORT=

# Optional LangSmith observability. When disabled or unset, no traces are sent.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=amazon-ops-local
# LANGSMITH_WORKSPACE_ID=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# PostgreSQL used by persistent task-creation idempotency.
POSTGRES_DB=amazon_ops
POSTGRES_USER=amazon_ops
POSTGRES_PASSWORD=amazon_ops
POSTGRES_PORT=5432
DATABASE_URL=postgresql://amazon_ops:amazon_ops@127.0.0.1:5432/amazon_ops
# Dedicated database role with SELECT-only access to shared_imported_advertising_report_rows.
DATABASE_READONLY_URL=
# Internal stdio MCP processes must receive the authenticated tenant ID at launch.

# Task creation idempotency.
IDEMPOTENCY_TTL_SECONDS=86400
IDEMPOTENCY_DB_POOL_SIZE=10

# Conversation memory. After 30 complete turns, the oldest 20 are summarized and archived.
CONVERSATION_MEMORY_MAX_TURNS=30
CONVERSATION_MEMORY_COMPACT_TURNS=20
CONVERSATION_MEMORY_DB_POOL_SIZE=10

# Authentication and transactional email. Keep SMTP credentials local only.
APP_BASE_URL=http://localhost:3001
AUTH_DB_POOL_SIZE=10
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
